{
  "name": "@loom-loyalty/meridian-conformance",
  "version": "0.3.0",
  "description": "Meridian conformance test suite. Response-shape validation helpers for runtimes and component implementations.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./priority": {
      "types": "./dist/priority/index.d.ts",
      "import": "./dist/priority/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@loom-loyalty/meridian-types": "workspace:*"
  },
  "devDependencies": {
    "@loom-loyalty/meridian-priority-reference": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
