{
  "name": "@loom-loyalty/meridian-runtime-cloudflare",
  "version": "0.7.0",
  "description": "Cloudflare Workers + Durable Objects reference adapter for the Meridian protocol. Implements the six stable runtime primitives. See specs/core/RUNTIME-SPEC.md.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/create-test-runtime.d.ts",
      "import": "./dist/testing/create-test-runtime.js"
    },
    "./agent": {
      "types": "./dist/agent-entry.d.ts",
      "import": "./dist/agent-entry.js"
    }
  },
  "files": [
    "dist",
    "src",
    "wrangler.toml.example",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@loom-loyalty/meridian-conformance": "workspace:*",
    "@loom-loyalty/meridian-types": "workspace:*",
    "croner": "^9.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261026.1",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loom-loyalty/meridian.git",
    "directory": "packages/runtime-cloudflare"
  }
}
