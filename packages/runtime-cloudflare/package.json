{
  "name": "@loom-loyalty/meridian-runtime-cloudflare",
  "version": "0.3.1",
  "description": "Cloudflare Workers + Durable Objects reference adapter for the Meridian protocol. Implements the six stable runtime primitives. See specs/core/RUNTIME-SPEC.md.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/create-test-runtime.d.ts",
      "import": "./dist/testing/create-test-runtime.js"
    }
  },
  "files": [
    "dist",
    "wrangler.toml.example",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@loom-loyalty/meridian-conformance": "workspace:*",
    "@loom-loyalty/meridian-types": "workspace:*",
    "croner": "^9.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9",
    "wrangler": "^3.100.0"
  }
}
