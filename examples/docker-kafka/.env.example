# Copy to `.env` before running `docker compose up`. Not committed.

# Required: URL of the Meridian worker the agent talks to.
MERIDIAN_ENDPOINT=https://your-meridian-worker.example.workers.dev

# Optional bearer token (M4 will enforce it; v0.1 accepts but ignores).
# MERIDIAN_TOKEN=

# Agent identity on the Meridian side. Must be unique across agents
# sharing this worker.
AGENT_ID=kafka-lag-monitor
AGENT_DOMAIN=infrastructure

# Polling cadence + emission threshold. Tune based on your Kafka
# volume — 60s/1000 is a reasonable starting point.
POLL_INTERVAL_MS=60000
LAG_THRESHOLD=1000
